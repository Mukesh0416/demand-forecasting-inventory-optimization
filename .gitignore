# ---------------------------------------------------------------------------
# Project data
# ---------------------------------------------------------------------------
# Raw M5 source files are large (~500+ MB) and are NEVER committed.
data/raw/*
!data/raw/.gitkeep

# Processed artifacts are normally ignored, EXCEPT the small set the
# Streamlit dashboard reads. These are committed so a fresh clone can run
# streamlit run dashboard/app.py without downloading the raw M5 dataset.
# See README.md -> "Reproducing the Project" -> "Processed artifacts".
data/processed/*
!data/processed/.gitkeep
!data/processed/audited_model_comparison.csv
!data/processed/inventory_scenarios.csv
!data/processed/inventory_abc_series.csv
!data/processed/inventory_abc_performance.csv
!data/processed/inventory_business_cases.csv
!data/processed/inventory_recommendations.csv
!data/processed/evaluation_population.parquet
!data/processed/inventory_policy.parquet
